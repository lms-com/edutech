# -------------------------------------------------------------
# Dockerfile tối ưu cho các Spring Boot Microservices (Java 21)
# Base Image: Eclipse Temurin JRE 21 Alpine siêu nhẹ (~160MB)
# -------------------------------------------------------------
FROM eclipse-temurin:21-jre-alpine

# Cài đặt curl, tzdata và ffmpeg để hỗ trợ Docker Health Check, chuẩn múi giờ và xử lý video HLS
RUN apk add --no-cache curl tzdata ffmpeg

ENV TZ=Asia/HoChiMinh

WORKDIR /app

# Khai báo argument nhận đường dẫn file JAR của từng service
ARG JAR_FILE

# Copy file jar vào container
COPY ${JAR_FILE} app.jar

# Biến môi trường mặc định giới hạn bộ nhớ JVM để chạy an toàn trên VPS
ENV JAVA_OPTS="-Xms128m -Xmx220m -Xss512k -XX:+UseSerialGC -XX:TieredStopAtLevel=1 -XX:MaxMetaspaceSize=110m -XX:+ExitOnOutOfMemoryError -Duser.timezone=Asia/HoChiMinh"
ENV SPRING_PROFILES_ACTIVE="prod"

# Chạy ứng dụng dưới user non-root để tăng cường bảo mật
RUN addgroup -S lmsgroup && adduser -S lmsuser -G lmsgroup
USER lmsuser:lmsgroup

ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar app.jar"]
